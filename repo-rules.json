{
  "version": 1,
  "skip_dirs": [
    ".git",
    ".tools",
    "output",
    "pdfium",
    "thirdparty",
    "build",
    "_deps"
  ],
  "skip_prefixes": [
    "build-",
    "cmake-build"
  ],
  "encoding": [
    {
      "glob": "*.md",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.ps1",
      "bom": true,
      "eol": "lf"
    },
    {
      "glob": "*.py",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.sh",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.yml",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.yaml",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "*.json",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": ".gitignore",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": ".gitattributes",
      "bom": false,
      "eol": "lf"
    },
    {
      "glob": "LICENSE",
      "bom": false,
      "eol": "lf"
    }
  ],
  "width": {
    "globs": [],
    "limit": 140,
    "tab_width": 4
  },
  "forbidden": [],
  "headers": {
    "globs": [],
    "first_line": "#pragma once",
    "forbid_namespace_using": false
  },
  "versions": [],
  "changelog": null,
  "required_files": [
    "LICENSE",
    "README.md",
    "repo-rules.json",
    "scripts/repo_rules.py",
    ".githooks/pre-commit",
    ".github/workflows/hygiene.yml"
  ],
  "markdown": {
    "globs": [
      "*.md"
    ],
    "check_links": true,
    "bilingual_pairs": []
  },
  "gitattributes": {
    "path": ".gitattributes",
    "required_patterns": []
  },
  "skip_globs": [
    "docs/cmake-build.md"
  ],
  "comments": {
    "english": true
  },
  "commit_message": {
    "english": true
  },
  "readme_badges": {
    "files": [
      "README.md"
    ],
    "min": 3,
    "require": [
      "actions/workflows/",
      "img.shields.io/badge/License"
    ]
  }
}
